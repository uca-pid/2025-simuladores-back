generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  nombre        String
  email         String        @unique
  password      String
  rol           String        @default("student")
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  exams         Exam[]
  intentos      ExamAttempt[]
  examHistory   ExamHistory[]
  inscripciones Inscription[]
  examFiles     ExamFile[]
  questionBank  QuestionBank[]
}

model Exam {
  id                    Int           @id @default(autoincrement())
  titulo                String
  profesorId            Int
  tipo                  String        @default("multiple_choice") // legacy/summary: "multiple_choice" | "programming" (no longer enforced now that exams are split into ExamPart)
  ordenAleatorio        Boolean       @default(false) // si las preguntas deben aparecer en orden aleatorio para cada estudiante
  eliminado             Boolean       @default(false) // soft-delete: examen oculto de listados pero conservado para intentos existentes
  profesor              User          @relation(fields: [profesorId], references: [id])
  intentos              ExamAttempt[]
  history               ExamHistory[]
  ventanas              ExamWindow[]
  partes                ExamPart[]
  examFiles             ExamFile[]
}

model ExamPart {
  id                    Int      @id @default(autoincrement())
  examId                Int
  orden                 Int
  tipo                  String   // "multiple_choice" | "programming"
  lenguajeProgramacion  String?       // "python" | "javascript" | "c" (solo para partes de programación)
  intellisenseHabilitado Boolean @default(false) // solo para partes de programación
  enunciadoTipo         String   @default("texto") // "texto" | "archivo" (mutuamente excluyentes)
  enunciadoProgramacion String?       // enunciado en texto (solo si enunciadoTipo = "texto")
  enunciadoUrl          String?       // ruta al archivo PDF/DOCX de consigna subido (solo si enunciadoTipo = "archivo")
  enunciadoArchivoNombre String?      // nombre original del archivo subido, para mostrar en la UI
  datasetCsvUrl         String?       // [legacy] ruta al único CSV de datos de versiones anteriores; usar datasetFiles
  datasetCsvNombre      String?       // [legacy] nombre original del CSV de versiones anteriores; usar datasetFiles
  datasetFiles          Json?         // array de { url, nombre } con los archivos de datos subidos (CSV/TXT)
  codigoInicial         String?       // código inicial/template para partes de programación
  testCases             Json?         // casos de prueba para evaluación automática de partes de programación
  solucionReferencia    String?       // solución de referencia del profesor (solo visible para él)
  exam                  Exam     @relation(fields: [examId], references: [id])
  preguntas             Pregunta[]

  @@unique([examId, orden])
}

model Pregunta {
  id       Int    @id @default(autoincrement())
  tipo     String @default("multiple_choice") // "multiple_choice" | "true_false" | "fill_in_blank" | "matching"
  texto    String
  opciones Json   // Array de opciones. Formato según tipo:
                  // - multiple_choice/true_false: array simple de strings
                  // - fill_in_blank: [respuestasCorrectas..., distractores...]
                  // - matching: [conceptos..., respuestas...]
  correcta Int    // Valor según tipo:
                  // - multiple_choice/true_false: índice de la opción correcta
                  // - fill_in_blank: cantidad de respuestas correctas (divide el array opciones)
                  // - matching: cantidad de conceptos (divide el array opciones)
  orden    Int?
  imagenUrl String?
  partId   Int
  parte    ExamPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  respuestasEstudiante RespuestaEstudiante[] // Respuestas de estudiantes a esta pregunta
}

model ExamHistory {
  id       Int      @id @default(autoincrement())
  userId   Int
  examId   Int
  viewedAt DateTime @default(now())
  exam     Exam     @relation(fields: [examId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, examId])
}

model ExamWindow {
  id            Int           @id @default(autoincrement())
  examId        Int
  nombre        String        // nombre descriptivo de la ventana
  fechaInicio   DateTime?
  duracion      Int?
  modalidad     String
  cupoMaximo    Int
  notas         String?
  estado        String        @default("programada")
  activa        Boolean       @default(true)
  sinTiempo     Boolean       @default(false)
  usaSEB        Boolean       @default(false) // si requiere Safe Exam Browser
  notasPublicadas Boolean     @default(false) // si las notas están visibles para los estudiantes
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  intentos      ExamAttempt[]
  kioskMode     Int           @default(0)
  
  // === Configuración de SEB ===
  // Modo y visualización
  sebKioskMode            Int    @default(0)    // 0=normal, 1=kiosk
  sebShowTaskBar          Boolean @default(false)
  sebBrowserViewMode      Int    @default(0)
  sebAllowAddressBar      Boolean @default(false)
  sebEnableBrowserWindowToolbar Boolean @default(false)
  
  // Navegación
  sebAllowQuit            Boolean @default(true)
  sebAllowReload          Boolean @default(true)
  sebAllowBrowsingBackForward Boolean @default(false)
  
  // Teclado
  sebEnableEsc            Boolean @default(false)
  sebEnableAltTab         Boolean @default(false)
  sebEnableAltEsc         Boolean @default(false)
  sebEnableAltF4          Boolean @default(false)
  sebEnableStartMenu      Boolean @default(false)
  sebEnableRightMouse     Boolean @default(true)
  sebEnablePrintScreen    Boolean @default(true)
  sebEnableFunctionKeys   Boolean @default(true)
  sebEnableCtrlEsc        Boolean @default(false)
  
  // Seguridad
  sebClipboardPolicy     Int     @default(2)    // 0=permitir todo, 1=bloquear entrada, 2=bloquear todo
  sebCreateNewDesktop     Boolean @default(true)
  sebLockOnMessageSocketClose Boolean @default(true)
  sebAllowSwitchToApplications Boolean @default(false)
  sebAllowDeveloperConsole Boolean @default(false)
  
  // Archivos
  sebAllowDownloads       Boolean @default(true)
  sebAllowUploads         Boolean @default(false)
  
  // URLs
  sebQuitUrl              String  @default("https://ferocarcineto.com.ar/")
  sebQuitPassword         String  @default("12345")
  sebSettingsPassword     String  @default("12345")
  
  // Configuración de Moodle
  moodleUrl     String?       // URL de la instancia de Moodle
  moodleToken   String?       // Token de Web Services de Moodle
  moodleCourseId Int?         // ID del curso en Moodle
  moodleActivityId Int?       // ID de la actividad/tarea en Moodle
  moodleSyncEnabled Boolean   @default(false) // Si está habilitada la sincronización
  lastMoodleSync DateTime?    // Última vez que se sincronizó con Moodle
  exam          Exam          @relation(fields: [examId], references: [id])
  inscripciones Inscription[]
}

model Inscription {
  id           Int        @id @default(autoincrement())
  userId       Int
  examWindowId Int
  inscribedAt  DateTime   @default(now())
  cancelledAt  DateTime?
  examWindow   ExamWindow @relation(fields: [examWindowId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, examWindowId])
}

model ExamAttempt {
  id           Int         @id @default(autoincrement())
  userId       Int
  examId       Int
  examWindowId Int?
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  ordenPreguntas Json?     // Array de IDs de preguntas en el orden randomizado para este intento
  codigoProgramacion String? // código del estudiante para exámenes de programación
  puntaje      Float?
  testResults  Json?       // resultados detallados de los test cases ejecutados
  estado       String      @default("en_progreso")
  calificacionManual Float? // calificación asignada manualmente por el profesor
  comentariosCorreccion String? // comentarios del profesor sobre la corrección
  corregidoPor Int?        // ID del profesor que corrigió
  corregidoAt  DateTime?   // fecha de corrección manual
  currentPartIndex Int     @default(0) // índice (0-based) de la ExamPart en curso, según orden
  partStatus   String      @default("en_curso") // "en_curso" | "esperando_continuar" | "finalizada"
  examWindow   ExamWindow? @relation(fields: [examWindowId], references: [id])
  exam         Exam        @relation(fields: [examId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
  respuestas   RespuestaEstudiante[] // Respuestas del estudiante a cada pregunta

  @@unique([userId, examId, examWindowId])
}

model RespuestaEstudiante {
  id         Int         @id @default(autoincrement())
  attemptId  Int
  preguntaId Int
  valor      Json        // Puede ser un índice (Int) para multiple choice/true_false, o un array para fill_in_blank/matching
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  pregunta   Pregunta    @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  @@unique([attemptId, preguntaId]) // Una respuesta por pregunta por intento
  @@index([attemptId])
  @@index([preguntaId])
}

model ExamFile {
  id        Int      @id @default(autoincrement())
  examId    Int
  userId    Int
  filename  String
  content   String?
  version   String   @default("manual") // "manual" | "submission" - tipo de guardado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam      Exam     @relation(fields: [examId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([examId, userId, filename, version])
}

model QuestionBank {
  id        Int      @id @default(autoincrement())
  profesorId Int
  tipo      String   @default("multiple_choice") // "multiple_choice" | "true_false" | "fill_in_blank" | "matching"
  titulo    String   @default("Sin título")
  texto     String
  opciones  Json     // Array de opciones. Formato según tipo:
                    // - multiple_choice/true_false: array simple de strings
                    // - fill_in_blank: [respuestasCorrectas..., distractores...]
                    // - matching: [conceptos..., respuestas...]
  correcta  Int      // Valor según tipo:
                    // - multiple_choice/true_false: índice de la opción correcta
                    // - fill_in_blank: cantidad de respuestas correctas (divide el array opciones)
                    // - matching: cantidad de conceptos (divide el array opciones)
  tags      Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profesor  User     @relation(fields: [profesorId], references: [id])
}
