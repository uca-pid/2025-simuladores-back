# Imagen sandbox para ejecutar código Python de exámenes de forma aislada.
# Pensada para correr con: podman run --rm --network=none --read-only ...
# (ver codeExecution.service.ts para los flags completos de hardening)

FROM python:3.11-alpine

# Usuario no-root dedicado. Combinado con podman rootless (user namespaces),
# un proceso que escape del contenedor cae como un UID sin privilegios del
# host, nunca como root.
RUN addgroup -S sandbox && adduser -S -G sandbox -h /home/sandbox sandbox

# Sin paquetes de sistema extra, sin pip install de nada: superficie mínima.
# Si el examen necesita librerías puntuales, agregarlas explícitamente aquí
# (nunca instalar en tiempo de ejecución dentro del sandbox).

WORKDIR /code
# El WORKDIR queda root:root pero legible por cualquiera (755): el usuario
# sandbox solo necesita poder abrir el archivo que se monta de solo lectura,
# nunca escribir ahí.
RUN chmod 755 /code

USER sandbox

# No se define ENTRYPOINT/CMD: el comando (python /code/script.py) lo pasa
# el service al hacer `podman run ... examline-sandbox-python python /code/script.py`
